  <tag k="description" v="La seconda tappa si inoltra in mezzo a noccioleti e boschi di castagni, passa dalla frazione di Braidi per poi vedere il panorama di Tindari con le Eolie sullo sfondo. La strada poi scende, prima dell’ultimo chilometro in salita verso il Santuario."/>
  <tag k="distance" v="21"/>
  <tag k="duration" v="7:0"/>
